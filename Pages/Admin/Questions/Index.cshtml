@page
@model SupportWorkerPortal.Pages.Admin.Questions.IndexModel
@{
    ViewData["Title"] = "Question Builder";
}

<div class="container admin-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Question Builder</h1>
            <p class="text-muted mb-0">Add, edit, reorder, and preview form questions.</p>
        </div>
        <a asp-page="Create" class="btn btn-primary">Add question</a>
    </div>

    @if (TempData["StatusMessage"] is string message)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <strong>Questions</strong> <span class="text-muted">(@Model.Questions.Count total)</span>
                </div>
                <div class="list-group list-group-flush" id="question-list">
                    @foreach (var question in Model.Questions)
                    {
                        <div class="list-group-item" data-question-id="@question.Id">
                            <div class="d-flex justify-content-between align-items-start gap-3">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge text-bg-secondary">#@question.DisplayOrder</span>
                                        @if (!question.IsActive)
                                        {
                                            <span class="badge text-bg-warning">Inactive</span>
                                        }
                                        @if (question.IsRequired)
                                        {
                                            <span class="badge text-bg-danger">Required</span>
                                        }
                                        <span class="badge text-bg-light text-dark border">@question.FieldType</span>
                                    </div>
                                    <div class="fw-semibold">@question.Label</div>
                                    @if (!string.IsNullOrWhiteSpace(question.HelpText))
                                    {
                                        <div class="small text-muted">@question.HelpText</div>
                                    }
                                </div>
                                <div class="btn-group btn-group-sm" role="group" aria-label="Reorder and actions">
                                    <form method="post" asp-page-handler="MoveUp" asp-route-id="@question.Id" class="d-inline">
                                        <button type="submit" class="btn btn-outline-secondary" title="Move up" aria-label="Move up">↑</button>
                                    </form>
                                    <form method="post" asp-page-handler="MoveDown" asp-route-id="@question.Id" class="d-inline">
                                        <button type="submit" class="btn btn-outline-secondary" title="Move down" aria-label="Move down">↓</button>
                                    </form>
                                    <a asp-page="Edit" asp-route-id="@question.Id" class="btn btn-outline-primary">Edit</a>
                                    <form method="post" asp-page-handler="ToggleActive" asp-route-id="@question.Id" class="d-inline">
                                        <button type="submit" class="btn btn-outline-warning">
                                            @(question.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm sticky-top preview-panel">
                <div class="card-header bg-white">
                    <strong>Live preview</strong>
                </div>
                <div class="card-body">
                    <partial name="_FormPreviewPartial" model="Model.ActiveQuestions" />
                </div>
            </div>
        </div>
    </div>

    @Html.AntiForgeryToken()
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
    <script>
        const list = document.getElementById('question-list');
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        if (list) {
            new Sortable(list, {
                animation: 150,
                onEnd: async () => {
                    const ids = [...list.querySelectorAll('[data-question-id]')]
                        .map(el => el.dataset.questionId);
                    await fetch('?handler=Reorder', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(ids)
                    });
                    location.reload();
                }
            });
        }
    </script>
}
